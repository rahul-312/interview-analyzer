# Copy to .env.local for local development. On Vercel, set these under Project > Settings > Environment Variables.
# NEXT_PUBLIC_* values are built into the pages, so redeploy after changing them.

# The API, e.g. https://<service>.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# The extension's Chrome Web Store page, once it's published.
# NEXT_PUBLIC_EXTENSION_URL=

# Shown on the Contact, Terms, Privacy, Refund and Shipping pages. Use the exact name and address on the
# Razorpay account (for an individual, your legal name). A production build (next build) fails without them.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Where disputes go to court, in the Terms. Defaults to Hyderabad, Telangana, India; change it if the address moves.
# NEXT_PUBLIC_LEGAL_JURISDICTION=
