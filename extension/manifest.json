{
  "manifest_version": 3,
  "name": "Interview Analyzer: Save jobs",
  "short_name": "Interview Analyzer",
  "version": "0.1.0",
  "description": "Save a job to Interview Analyzer from Naukri, or from any job page, without leaving it.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save this job to Interview Analyzer",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*", "https://naukri.com/*"],
      "js": ["content/sites.js", "content/ui.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
