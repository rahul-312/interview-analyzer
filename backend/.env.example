SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=interview-analyzer
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# AI jobs each plan can run in any rolling 24 hours (Pro Plus is shown as "Unlimited, fair use").
FREE_ANALYSES_PER_24H=2
PRO_ANALYSES_PER_24H=15
PRO_PLUS_ANALYSES_PER_24H=50
# Prep plans (new or regenerated) per rolling 24 hours.
FREE_PREP_PLANS_PER_24H=1
PRO_PREP_PLANS_PER_24H=5
PRO_PLUS_PREP_PLANS_PER_24H=15
# Failed analyses and prep plans that already cost an API call are given back up to this many times per 24 hours.
BILLED_REFUNDS_PER_24H=3

# Leave blank to run tasks inline and use the rule-based analyzer.
CELERY_BROKER_URL=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# false once billing is on for the key's project (the app then stops saying Google may use the data)
GEMINI_FREE_TIER=true
# The better model Pro Plus uses (blank: GEMINI_MODEL).
GEMINI_PRO_MODEL=
# A key on a billing-enabled project. Paid plans' debriefs never go to a free-tier key: without this
# (or a paid GEMINI_API_KEY), paid plans use the rule-based engine.
GEMINI_PAID_API_KEY=
# Celery queue for Pro Plus jobs.
CELERY_PRIORITY_QUEUE=priority

# Razorpay (see BILLING.md). Test keys (rzp_test_) everywhere but production. Blank: buying is off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: link existing Razorpay plans instead of creating them with `manage.py setup_razorpay_plans`.
# RAZORPAY_PLAN_PRO_MONTHLY=
# RAZORPAY_PLAN_PRO_YEARLY=
# RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
# RAZORPAY_PLAN_PRO_PLUS_YEARLY=
# Days of paid access kept after a failed renewal, while Razorpay retries the charge.
BILLING_GRACE_DAYS=3
# Send our own billing emails as well as Razorpay's (needs Django EMAIL_* settings).
BILLING_EMAILS=false
