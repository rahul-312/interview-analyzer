SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=interview-analyzer
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Round analyses a free user can run in any 24 hours (Pro is unlimited).
FREE_ANALYSES_PER_24H=2
# Prep plans (new or regenerated) a free user can generate in any 24 hours.
FREE_PREP_PLANS_PER_24H=2
# Failed analyses and prep plans that already cost an API call are given back up to this many times per 24 hours.
BILLED_REFUNDS_PER_24H=3

# Leave blank to run tasks inline and use the rule-based analyzer.
CELERY_BROKER_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
